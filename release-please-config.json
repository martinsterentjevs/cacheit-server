{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": ".release-please/CHANGELOG.generated.md",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "draft": false,
      "prerelease": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true
    }
  },
  "pull-request-title-pattern": "chore(release): ${version}",
  "pull-request-header": ":robot: Release PR — merge to tag, build once, and deploy to both prod and demo",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" },
    { "type": "refactor", "hidden": true, "section": "Refactoring" },
    { "type": "docs", "hidden": true, "section": "Documentation" },
    { "type": "chore", "hidden": true, "section": "Chores" },
    { "type": "test", "hidden": true, "section": "Tests" },
    { "type": "ci", "hidden": true, "section": "CI" },
    { "type": "style", "hidden": true, "section": "Style" }
  ]
}
